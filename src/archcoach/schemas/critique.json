{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["strengths", "findings", "lessons", "quiz"],
  "properties": {
    "strengths": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/finding"}},
    "lessons": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/lesson"}},
    "quiz": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/quiz_question"}}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "line", "end_line", "label", "valid"], "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "end_line": {"type": ["integer", "null"], "minimum": 1}, "label": {"type": "string"}, "valid": {"type": "boolean"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "title", "observation", "why_it_matters", "improvement", "tradeoffs", "evidence"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["high", "medium", "low"]}, "title": {"type": "string"}, "observation": {"type": "string"}, "why_it_matters": {"type": "string"}, "improvement": {"type": "string"}, "tradeoffs": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "lesson": {"type": "object", "additionalProperties": false, "required": ["id", "title", "explanation", "code_example", "self_check", "answer", "exercise", "evidence"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "explanation": {"type": "string"}, "code_example": {"type": "string"}, "self_check": {"type": "string"}, "answer": {"type": "string"}, "exercise": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "quiz_question": {"type": "object", "additionalProperties": false, "required": ["id", "question", "options", "correct_index", "explanations", "evidence"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "question": {"type": "string"}, "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}, "correct_index": {"type": "integer", "minimum": 0, "maximum": 3}, "explanations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}, "evidence": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/evidence"}}}}
  }
}
